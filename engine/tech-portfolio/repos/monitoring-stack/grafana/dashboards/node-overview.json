{
  "__note": "Starter dashboard, hand-authored. Replace with the real exported JSON after the stack runs on the homelab host; do not present this as a production export.",
  "title": "Node Overview (starter)",
  "schemaVersion": 39,
  "refresh": "1m",
  "panels": [
    { "type": "timeseries", "title": "CPU busy %", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [{ "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)" }] },
    { "type": "timeseries", "title": "Memory available", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [{ "expr": "node_memory_MemAvailable_bytes" }] },
    { "type": "timeseries", "title": "Filesystem used %", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [{ "expr": "100 - (node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay\"} * 100)" }] },
    { "type": "timeseries", "title": "Disk temperature (SMART)", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [{ "expr": "smartctl_device_temperature" }] }
  ]
}
