# Copy to /etc/restic/backup.env, chown root:root, chmod 0600. Never commit the real file.
RESTIC_REPOSITORY=REPLACE_WITH_REPO_URL            # e.g. sftp:user@host:/backups/restic or s3:...
RESTIC_PASSWORD_FILE=/etc/restic/repo-password     # file containing only the repo password
BACKUP_PATHS=/opt/stack /etc /home/REPLACE_WITH_USER
