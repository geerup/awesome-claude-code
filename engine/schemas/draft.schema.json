{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "draft.schema.json",
  "title": "Writer output (outputs/**/draft.json). Every line cites fact ids and an approved variant, or is marked proposed.",
  "type": "object",
  "required": ["draft_id", "kind", "market", "name", "sections"],
  "additionalProperties": false,
  "definitions": {
    "line": {
      "type": "object",
      "required": ["line_id", "text", "fact_ids"],
      "additionalProperties": false,
      "properties": {
        "line_id": {"type": "string"},
        "text": {"type": "string", "minLength": 1},
        "fact_ids": {"type": "array", "items": {"type": "string"}},
        "variant_id": {"type": ["string", "null"]},
        "proposed": {"type": "boolean"}
      }
    }
  },
  "properties": {
    "draft_id": {"type": "string"},
    "kind": {"enum": ["cv"]},
    "market": {"enum": ["MENA", "western_global"]},
    "name": {"type": "string"},
    "jd_ref": {"type": "string"},
    "note": {"type": "string"},
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["section_id", "kind", "lines"],
        "additionalProperties": false,
        "properties": {
          "section_id": {"type": "string"},
          "kind": {"enum": ["header", "summary", "role", "earlier", "skills", "other"]},
          "entry_id": {"type": "string"},
          "title": {"type": "string"},
          "org": {"type": "string"},
          "dates": {"type": "string"},
          "subtitle": {"$ref": "#/definitions/line"},
          "lines": {"type": "array", "items": {"$ref": "#/definitions/line"}}
        },
        "if": {"properties": {"kind": {"const": "role"}}},
        "then": {"required": ["entry_id", "title", "org", "dates"]}
      }
    }
  }
}
