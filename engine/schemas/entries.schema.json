{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "entries.schema.json",
  "title": "Role entries (data/entries.json, generated by scripts/fact_bank.py)",
  "type": "object",
  "required": ["master_sha256", "entries"],
  "additionalProperties": false,
  "properties": {
    "master_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "entries": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["entry_id", "org", "title", "dates", "rules"],
        "additionalProperties": false,
        "properties": {
          "entry_id": {"type": "string"},
          "org": {"type": "string"},
          "title": {"type": "string"},
          "dates": {"type": "string"},
          "rules": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
