{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "fact.schema.json",
  "title": "Atomic fact (one line of data/facts.jsonl, generated by scripts/fact_bank.py)",
  "type": "object",
  "required": ["fact_id", "entry_id", "claim", "numbers", "entities", "themes", "source",
               "status", "usable", "constraints", "master_sha256"],
  "additionalProperties": false,
  "properties": {
    "fact_id": {"type": "string", "pattern": "^[A-Z]{2,3}-[A-Za-z0-9_-]+$"},
    "entry_id": {"type": "string"},
    "claim": {"type": "string", "minLength": 1},
    "numbers": {"type": "array", "items": {"type": "string"}},
    "entities": {"type": "array", "items": {"type": "string"}},
    "themes": {"type": "array", "items": {"type": "string"}},
    "source": {"type": "string"},
    "status": {"enum": ["Folder", "Computed", "San only", "Conflict", "Inference"]},
    "usable": {"type": "boolean"},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "master_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "if": {"properties": {"status": {"enum": ["Conflict", "Inference"]}}},
  "then": {"properties": {"usable": {"const": false}}}
}
