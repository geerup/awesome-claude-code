<!-- 04 BodyCopy. 15px, line height about 1.7, right-aligned in Arabic. Copy slot.
     Maps to data-ortto-module="paragraph" data-slot="copy" data-role="body".
     Bound by data-copy-id in the slotted source of truth; example copy below. -->
<mj-section background-color="#1A1A1A" padding="18px 24px 0" css-class="px">
  <mj-column>
    <mj-text color="#E6E6E6" font-size="15px" line-height="1.7" align="right">
      نص الفقرة يأتي هنا كنص حيّ مرتبط بنسخة مجازة من حزمة النصوص، لا نص مكتوب يدويًا في القالب.
    </mj-text>
  </mj-column>
</mj-section>
