        <table role="presentation" width="176" cellpadding="0" cellspacing="0" background="https://dt92b02v6m7lx.cloudfront.net/05032024_RaghebBG_141414-BOTTOM-GRADIENT-01.webp" bgcolor="#1A1A1A" style="width:100%;max-width:176px;height:236px;background:url('https://dt92b02v6m7lx.cloudfront.net/05032024_RaghebBG_141414-BOTTOM-GRADIENT-01.webp') center/cover no-repeat,#1A1A1A;background-size:cover;background-position:center top;border-radius:12px;">
          <tr><td valign="bottom" align="right" style="height:236px;padding:14px 12px;text-align:right;">
            <div style="width:26px;height:3px;background:#009975;font-size:0;line-height:0;margin:0 0 8px;">&nbsp;</div>
            <div data-slot="copy" data-role="card-name" data-lang="ar" style="color:#FFFFFF;font-size:15px;font-weight:700;line-height:1.3;font-family:'Lyon Arabic Display','29LT Azer',Tahoma,Arial,sans-serif;">راغب علامة</div>
            <div data-slot="copy" data-role="card-subject" data-lang="ar" style="color:#E6E6E6;font-size:12px;line-height:1.4;padding-top:3px;font-family:'Lyon Arabic Display','29LT Azer',Tahoma,Arial,sans-serif;">يعلّم الموسيقى والأداء</div>
