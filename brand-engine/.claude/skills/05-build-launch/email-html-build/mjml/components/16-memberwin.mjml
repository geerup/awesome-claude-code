<!-- 16 MemberWin, the social-proof block (the extension set, per context/email-design-system.md).
     One REAL, CONSENTED member testimonial (data-role="quote"), the attribution (data-role="body"),
     and a short reflective bridge line (data-role="body") that leads into the single primary Button.
     The testimonial must be real and consented, NEVER invented or paraphrased into a claim;
     authenticity is checked at brand QA and compliance. scripts/email_render.py emits it from the
     spec's member_win and is the source of truth; this MJML mirrors it. The labels are QA-passed
     copy bound by data-copy-id. The example below is the AR block, shown for structure. -->
<mj-text align="right" color="#009975" font-size="13px" font-weight="700" letter-spacing="2px"
         padding="18px 40px 8px" font-family="'Lyon Arabic Display','29LT Azer',Tahoma,Arial,sans-serif">
  قصص المشتركين
</mj-text>
<mj-text align="right" color="#FFFFFF" font-size="18px" line-height="1.6" padding="0 40px 8px"
         css-class="ar" data-role="quote"
         font-family="'Lyon Arabic Display','29LT Azer',Tahoma,Arial,sans-serif">
  <div data-slot="copy" data-role="quote" data-lang="ar" data-copy-id="email-<campaign>-e1-memberwin-quote-ar">اقتباس حقيقي وموثق من احد المشتركين</div>
</mj-text>
<mj-text align="right" color="#9A9A9A" font-size="13px" padding="0 40px 8px" css-class="ar"
         font-family="'Lyon Arabic Display','29LT Azer',Tahoma,Arial,sans-serif">
  <div data-slot="copy" data-role="body" data-lang="ar" data-copy-id="email-<campaign>-e1-memberwin-attribution-ar">احد المشتركين</div>
</mj-text>
<mj-text align="right" color="#E6E6E6" font-size="15px" line-height="1.85" padding="0 40px 12px"
         css-class="ar" font-family="'Lyon Arabic Display','29LT Azer',Tahoma,Arial,sans-serif">
  <div data-slot="copy" data-role="body" data-lang="ar" data-copy-id="email-<campaign>-e1-memberwin-bridge-ar">سطر يربط القصة بدعوة واضحة الى الفعل</div>
</mj-text>
