<!-- 03 SectionHeading. An emerald eyebrow (letter-spaced) plus an H1. Two copy slots.
     Maps to data-ortto-module="heading" data-slot="copy", data-role="eyebrow" and "headline".
     The text is bound by data-copy-id in the slotted source of truth; here it is example copy. -->
<mj-section background-color="#1A1A1A" padding="30px 24px 0" css-class="px">
  <mj-column>
    <mj-text color="#009975" font-size="13px" font-weight="700" letter-spacing="2px" align="right">مهارات</mj-text>
    <mj-text color="#FFFFFF" font-size="28px" font-weight="700" line-height="1.45" align="right" padding="10px 0 0">
      عنوان الرسالة يأتي هنا كنص حيّ
    </mj-text>
  </mj-column>
</mj-section>
