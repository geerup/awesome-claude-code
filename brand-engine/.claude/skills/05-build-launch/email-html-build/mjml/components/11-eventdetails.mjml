<!-- 11 EventDetails. Date, time, seats for a live session or masterclass, a bordered panel.
     Copy slot. Maps to data-ortto-module="text" data-slot="copy" data-role="eventdetails".
     Never invent a date, time, or seat count; all are brief inputs and bound by data-copy-id.
     The Bassam non-payer flow has no live session, so this block is NOT used there. -->
<mj-section background-color="#1A1A1A" padding="10px 24px 4px" css-class="px">
  <mj-column border="1px solid #2A2A2A" border-radius="14px">
    <mj-text color="#FFFFFF" font-size="15px" font-weight="600" align="right" padding="13px 18px"
             border-bottom="1px solid #2A2A2A">التاريخ: يأتي من الموجز</mj-text>
    <mj-text color="#FFFFFF" font-size="15px" font-weight="600" align="right" padding="13px 18px"
             border-bottom="1px solid #2A2A2A">الوقت: يأتي من الموجز</mj-text>
    <mj-text color="#FFFFFF" font-size="15px" font-weight="600" align="right" padding="13px 18px">المقاعد: يأتي من الموجز</mj-text>
  </mj-column>
</mj-section>
