<!-- 12 BillingNotice. A calm transactional notice (payment issue). Copy slot, light or dark.
     Maps to data-ortto-module="paragraph" data-slot="copy" data-role="billing".
     Transactional and lifecycle only; may use the light paper theme. Bound by data-copy-id.
     Not used in the Bassam marketing flow. -->
<mj-section background-color="#1A1A1A" padding="18px 24px 0" css-class="px">
  <mj-column>
    <mj-text color="#FFFFFF" font-size="22px" font-weight="700" align="right">عنوان الإشعار يأتي هنا</mj-text>
    <mj-text color="#E6E6E6" font-size="15px" line-height="1.9" align="right" padding="8px 0 0">
      نص الإشعار الهادئ يأتي هنا كنص حيّ مرتبط بنسخة مجازة.
    </mj-text>
  </mj-column>
</mj-section>
