<!-- 15 IssueIndex, the optional "in this issue" table of contents (the extension set, per
     context/email-design-system.md). A numbered index at the top of a digest, magazine style, right
     after the SectionHeading. ONE copy slot (data-role="index"), Western numerals (01, 02, 03), each
     entry a link to its section. scripts/email_render.py emits it from the spec's issue_index and is
     the source of truth; this MJML mirrors it. The labels are QA-passed copy bound by data-copy-id.
     The example below is the AR row of three entries, shown for structure. -->
<mj-text align="right" color="#009975" font-size="13px" font-weight="700" letter-spacing="2px"
         padding="18px 40px 8px" font-family="'Lyon Arabic Display','29LT Azer',Tahoma,Arial,sans-serif">
  في هذا العدد
</mj-text>
<mj-text align="right" color="#E6E6E6" font-size="15px" line-height="1.7" padding="0 40px 10px"
         css-class="ar"
         font-family="'Lyon Arabic Display','29LT Azer',Tahoma,Arial,sans-serif">
  <div data-slot="copy" data-role="index" data-lang="ar" data-copy-id="email-<campaign>-e1-issueindex-ar">
    <div style="padding:4px 0;"><a href="#s1" style="color:#E6E6E6;text-decoration:none;">01&nbsp;&nbsp;العنوان الاول</a></div>
    <div style="padding:4px 0;"><a href="#s2" style="color:#E6E6E6;text-decoration:none;">02&nbsp;&nbsp;العنوان الثاني</a></div>
    <div style="padding:4px 0;"><a href="#s3" style="color:#E6E6E6;text-decoration:none;">03&nbsp;&nbsp;العنوان الثالث</a></div>
  </div>
</mj-text>
