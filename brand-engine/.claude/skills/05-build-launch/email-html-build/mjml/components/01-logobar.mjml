<!-- 01 LogoBar. Centered Maharat logo on paper, ~118px, text-free image element.
     Maps to data-ortto-module="image" data-slot="element". Autopilot CDN logo from the references. -->
<mj-section background-color="#141414" padding="16px 0 20px">
  <mj-column>
    <mj-image src="https://m.autopilotapp.com/maharat/logo/l_80b9b5a2-f18b-4bc7-a859-2cf899449f05.png"
              width="118px" alt="مهارات" href="https://www.maharat.com" padding="0" />
  </mj-column>
</mj-section>
