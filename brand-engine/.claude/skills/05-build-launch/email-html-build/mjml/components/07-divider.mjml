<!-- 07 Divider. A hairline rule. Structural.
     Maps to data-ortto-module="divider" data-slot="structural". -->
<mj-section background-color="#1A1A1A" padding="6px 24px" css-class="px">
  <mj-column>
    <mj-divider border-width="1px" border-color="#262626" padding="0" />
  </mj-column>
</mj-section>
