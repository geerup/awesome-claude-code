<!-- 05 Button. The canonical single CTA. Copy slot for the label, data-link-slot for the URL.
     Maps to data-ortto-module="button" data-slot="copy" data-role="cta".
     WCAG AA: near-black #141414 label on emerald #009975 (about 5:1). Never white on emerald at
     normal weight. One primary CTA per email.
     NOTE: the committed slotted HTML wraps this in an MSO VML roundrect ([if mso]) for Outlook
     plus this non-mso pill ([if !mso]). MJML emits the pill; the VML fallback is added in the
     slotted source of truth, which is the source of truth this compiles to match. -->
<mj-section background-color="#1A1A1A" padding="14px 24px 6px" css-class="px">
  <mj-column>
    <mj-button background-color="#009975" color="#141414" font-size="16px" font-weight="700"
               border-radius="28px" inner-padding="15px 44px" align="center"
               href="https://maharat.com/class/design-style/bassam-fattouh-teaches-makeup">
      ابدأ الآن
    </mj-button>
  </mj-column>
</mj-section>
