<!-- 06 PromoLine. A code chip plus a short urgency line. Copy slot (the chip is structural).
     Maps to data-ortto-module="text" data-slot="copy" data-role="body".
     Never invent a code or a deadline; both are brief inputs.
     PENDING: the design system specs a gold chip (#C4963C), which is NOT in the constitution and
     is pending Ahmed. Until then the chip uses constitution colors only (panel #1A1A1A border,
     emerald #009975 text). Do not use gold in a customer-facing email. -->
<mj-section background-color="#1A1A1A" padding="10px 24px 2px" css-class="px">
  <mj-column>
    <mj-text align="center" color="#009975" font-size="16px" font-weight="700" letter-spacing="3px"
             border="1px solid #009975" border-radius="10px" padding="9px 16px" container-background-color="#141414">
      CODE
    </mj-text>
    <mj-text align="center" color="#9A9A9A" font-size="13px" padding="8px 0 0">سطر العرض يأتي هنا</mj-text>
  </mj-column>
</mj-section>
