{
 "skill": "instructor-marketing/elda-choucair",
 "description": "Acceptance checks for elda-choucair assets. Machine first (eval_runner), then llm, then arabic-copy-qa, brand-qa, human gate.",
 "binding_sources": {
  "facts": "context/instructors/elda-choucair.md"
 },
 "machine_checks": [
  {
   "id": "no-em-dash",
   "severity": "hard",
   "regex": "—",
   "fail_if": "match",
   "fix": "Replace em dash",
   "applies_to": "all"
  },
  {
   "id": "no-en-dash",
   "severity": "hard",
   "regex": "–",
   "fail_if": "match",
   "fix": "Replace en dash",
   "applies_to": "all"
  },
  {
   "id": "no-tatweel",
   "severity": "hard",
   "regex": "ـ",
   "fail_if": "match",
   "fix": "Remove tatweel",
   "applies_to": "all"
  },
  {
   "id": "no-eastern-numerals",
   "severity": "hard",
   "regex": "[٠-٩۰-۹]",
   "fail_if": "match",
   "fix": "Western numerals",
   "applies_to": "all"
  },
  {
   "id": "no-accreditation",
   "severity": "hard",
   "regex": "(معتمد|accredit)",
   "fail_if": "match",
   "fix": "No accreditation claims",
   "applies_to": "assets"
  },
  {
   "id": "blocked-100-brands",
   "severity": "hard",
   "regex": "100\\s*\\+?\\s*(brand|علامة)",
   "fail_if": "match",
   "fix": "Unverified placeholder (claims row 4)",
   "applies_to": "assets"
  },
  {
   "id": "blocked-spend-figures",
   "severity": "hard",
   "regex": "\\$\\s?[0-9]",
   "fail_if": "match",
   "fix": "Spend figures unverified (row 4)",
   "applies_to": "assets"
  }
 ],
 "llm_checks": [
  {
   "id": "status-gate",
   "severity": "hard",
   "rule": "Public-facing only when catalog public status is launched."
  },
  {
   "id": "claims-verified-only",
   "severity": "hard",
   "rule": "Every factual claim matches a verified claims-table row; held-back rows never run."
  },
  {
   "id": "register-policy",
   "severity": "hard",
   "rule": "New copy in Gulf-familiar MSA or brand-tone EN; source colloquial is reference only."
  },
  {
   "id": "no-invented-product",
   "severity": "hard",
   "rule": "Class titles, lessons, dates only as recorded in the fact file or brief."
  }
 ],
 "golden_examples": [
  {
   "label": "pass",
   "text": "السوق لا يكافئ أفضل منتج، بل المنتج الذي يعرف كيف يتكلم. خبرة أكثر من 20 سنة في صف واحد.",
   "why": "Verified claims, MSA, house style."
  },
  {
   "label": "fail",
   "text": "عملت مع 100+ علامة تجارية — صدقوني.",
   "why": "Blocked 100-brands claim and em dash."
  }
 ]
}